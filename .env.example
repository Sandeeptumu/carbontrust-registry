# Copy to .env and set unique secrets. Never commit .env.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=carbontrust
DB_USERNAME=carbontrust
DB_PASSWORD=replace-with-unique-runtime-database-password
MYSQL_ROOT_PASSWORD=replace-with-unique-operator-password
# Flyway schema migration requires an operator account; runtime account should have DML only.
FLYWAY_USER=root
FLYWAY_PASSWORD=replace-with-operator-password
# Exact public origin, without trailing slash. Use HTTPS in deployment.
APP_URL=https://registry.example.org
SECURE_COOKIES=true
MAIL_FROM=CarbonTrust <no-reply@registry.example.org>
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_USERNAME=replace-with-mail-user
SMTP_PASSWORD=replace-with-mail-password
SMTP_AUTH=true
SMTP_TLS=true
