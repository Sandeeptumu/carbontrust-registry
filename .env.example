# CarbonTrust Registry — environment template
# Copy this file to .env and fill in real values. NEVER commit .env.

# --- MySQL (used by docker-compose) ---
DB_HOST=mysql
DB_PORT=3306
DB_NAME=carbontrust
DB_USERNAME=root
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- Backend ---
JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
JWT_EXPIRATION=3600000

# --- Frontend (Vite build arg; browser must reach the backend on this URL) ---
VITE_API_URL=http://localhost:8080
