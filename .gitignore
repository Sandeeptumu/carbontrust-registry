# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*



.DS_Store

.idea/
*.iml

# Mobile (Expo / React Native)
mobile/node_modules/
mobile/.expo/
mobile/dist/
mobile/web-build/
mobile/*.log
mobile/.expo-shared/

# --- Production prep: secrets & generated artifacts ---
# Environment files — never commit real secrets. .env.example (placeholders only) IS committed.
.env
.env.*
!.env.example

# Database dumps / backups — never commit SQL files
*.sql
# ...but never ignore real migration SQL (Flyway/Liquibase), if added later
!backend/src/main/resources/db/migration/**

# Build artifacts & dependencies (defense in depth; also covered by sub-gitignores)
node_modules/
target/
dist/
.vercel/

# Editor directories
.vscode/
